-- ap_ext_news.script

if not ap_ext_news then
	return
end

-- ===================================================================
--  xlevel.get_smart_name （AlifePlusの#location#に挿入される地名を短縮）
-- ===================================================================
local function patch_news_smart_name()
	if not xlevel
	or type(xlevel.get_smart_name) ~= "function"
	or type(xlevel.get_level_id) ~= "function"
	or type(xlevel.get_actor_level) ~= "function"
	then
		return
	end

	local original_get_smart_name = xlevel.get_smart_name
	xlevel.get_smart_name = function(smart, ...)
		local name = original_get_smart_name(smart, ...)

		if name and smart then
			local info = debug.getinfo(2, "S")
			if info and info.short_src and string.find(info.short_src, "ap_ext_news", 1, true) then
				local smart_level = xlevel.get_level_id(smart)
				local actor_level = xlevel.get_actor_level()
				if smart_level and actor_level and smart_level ~= actor_level then
					-- 別レベル: 「ザトンの[スカドフスク]」と表示
					local location = string.gsub(name, "%s+(%[)", "の%1")
					return location
				else
					-- 同じレベル: 「[スカドフスク]」と表示
					local location = string.match(name, "(%[.+%])$")
					if location then return location end
				end
			end
		end

		return name
	end
end

patch_news_smart_name()

-- ===================================================================
--  _format_template （タグに何も挿入されなかった場合、後ろの1文字を削除 & ミリタリー置換）
-- ===================================================================
local function patch_news_template()
	local run_news_tick = ap_ext_news.run_news_tick
	if type(run_news_tick) ~= "function" then return end

	local build_news_tick

	local i = 1
	while true do
		local name, value = debug.getupvalue(run_news_tick, i)
		if not name then break end
		if name == "_build_news_tick" then
			build_news_tick = value
			break
		end
		i = i + 1
	end

	if type(build_news_tick) ~= "function" then return end

	local format_template_index
	local original_format_template
	local j = 1
	while true do
		local name, value = debug.getupvalue(build_news_tick, j)
		if not name then break end
		if name == "_format_template" then
			format_template_index = j
			original_format_template = value
			break
		end
		j = j + 1
	end

	if not format_template_index or type(original_format_template) ~= "function" then return end

	local removable_tags = {
		subject_faction = true,
		subject_species = true,
		subject_name = true,
		other_faction = true,
	}
	local utf8_pattern = "[\1-\127\192-\255][\128-\191]*"
	local tagged_character_pattern = "#([%w_]+)#(" .. utf8_pattern .. ")"

	debug.setupvalue(build_news_tick, format_template_index, function(template, slots, ...)
		local result = string.gsub(template, tagged_character_pattern, function(tag, following_character)
			if removable_tags[tag] and slots[tag] == "" then return "" end
			return "#" .. tag .. "#" .. following_character
		end)

		local final_msg = original_format_template(result, slots, ...)
		local translated_msg = string.gsub(final_msg, "ミリタリー", "軍")
		return translated_msg
	end)
end

patch_news_template()
