-- tasks_guide.script

-- ===================================================================
--  squad_on_npc_death （護衛対象全滅時のメッセージ）
--  news_manager.send_tipにフック
-- ===================================================================
if tasks_guide
and tasks_guide.squad_on_npc_death
and news_manager
and news_manager.send_tip
then
	local original_squad_on_npc_death = tasks_guide.squad_on_npc_death
	local target_text = "The squad you were escorting has died. You were supposed to protect them. Other Stalkers will notice this."

	tasks_guide.squad_on_npc_death = function(...)
		local backup_send_tip = news_manager.send_tip

		news_manager.send_tip = function(actor, text, ...)
			if text == target_text then
				text = "護衛対象の分隊が全滅し、任務に失敗した。\\nこの件は他のストーカーたちにも知れ渡るだろう。"
			end
			return backup_send_tip(actor, text, ...)
		end

		local ok, result = pcall(original_squad_on_npc_death, ...)
		news_manager.send_tip = backup_send_tip
		if not ok then error(result, 0) end
		return result
	end
end

-- ===================================================================
--  fail_complete_late （タイムオーバー時の失敗セリフ）
--  news_manager.send_tipにフック
-- ===================================================================
if tasks_guide
and tasks_guide.fail_complete_late
and news_manager
and news_manager.send_tip
then
	local original_fail_complete_late = tasks_guide.fail_complete_late
	local target_text = "Seriously? We're still not there yet? Forget it. You're paying me for wasting my time. Bye."

	tasks_guide.fail_complete_late = function(...)
		local backup_send_tip = news_manager.send_tip

		news_manager.send_tip = function(actor, text, ...)
			if text == target_text then
				text = "マジかよ？まだ着かないのか？\\nもういい、時間を無駄にされた分の違約金を払ってもらうぞ。じゃあな。"
			end
			return backup_send_tip(actor, text, ...)
		end

		local ok, result = pcall(original_fail_complete_late, ...)
		news_manager.send_tip = backup_send_tip
		if not ok then error(result, 0) end
		return result
	end
end

-- ===================================================================
--  prepare_follower （先導タスクの開始メッセージ & マップマーカー整形）
--  string.format および level.map_add_object_spot にフック
-- ===================================================================
if tasks_guide
and tasks_guide.prepare_follower
then
	local original_prepare_follower = tasks_guide.prepare_follower

	tasks_guide.prepare_follower = function(...)
		local backup_format = string.format
		local backup_map_add = level and level.map_add_object_spot
		local target_fmt = game.translate_string("st_jg_14")

		-- 名前(3)と現在地(2)を入れ替え
		string.format = function(fmt, ...)
			if fmt == target_fmt then
				local args = {...}
				if #args >= 3 then
					return backup_format(fmt, args[1], args[3], args[2])
				end
			end
			return backup_format(fmt, ...)
		end

		-- マップマーカーのラベル短縮（Tasks Guide Spotの日本語表示崩れ防止）
		if backup_map_add then
			level.map_add_object_spot = function(id, spot, hint, ...)
				if spot == "secondary_task_location" and type(hint) == "string" then
					local dest = hint:match("^(.-)まで")
					local short_hint = (dest and dest ~= "" and #dest <= 30) and (dest .. "への先導依頼") or "先導依頼"
					hint = short_hint .. "\\n" .. hint
				end
				return backup_map_add(id, spot, hint, ...)
			end
		end

		local ok, result = pcall(original_prepare_follower, ...)
		string.format = backup_format
		if backup_map_add then
			level.map_add_object_spot = backup_map_add
		end
		if not ok then error(result, 0) end
		return result
	end
end

-- ===================================================================
--  activate （マップ上のタスクマーカーのメッセージ & マップマーカー整形）
--  level.map_add_object_spot_serにフック
-- ===================================================================
if tasks_guide
and tasks_guide.activate
then
	local original_activate = tasks_guide.activate

	tasks_guide.activate = function(...)
		local backup_map_add = level.map_add_object_spot_ser

		level.map_add_object_spot_ser = function(id, spot, hint, ...)
			if spot == "secondary_task_location" and type(hint) == "string" then
				local detail = hint .. "までの案内を頼まれた"
				local dest = hint:match("^ストーカーから%s*(.+)")
				local map_name = dest and (dest:match("^(.-)にある") or dest:match("^(.-)の") or dest:match("^(%S+)"))
				local short_hint = (map_name and map_name ~= "" and #map_name <= 27) and (map_name .. "への先導依頼") or "先導依頼"
				hint = short_hint .. "\\n" .. detail
			end
			return backup_map_add(id, spot, hint, ...)
		end

		local ok, result = pcall(original_activate, ...)
		level.map_add_object_spot_ser = backup_map_add
		if not ok then error(result, 0) end
		return result
	end
end

-- ===================================================================
--  get_phrase_1 （先導タスクのメッセージ、金額のカンマ区切り化）
-- ===================================================================
if tasks_guide
and tasks_guide.get_phrase_1
then
	local original_get_phrase_1 = tasks_guide.get_phrase_1

	tasks_guide.get_phrase_1 = function(...)
		local backup_format = string.format
		local target_fmt = game.translate_string("st_jg_16")

		string.format = function(fmt, ...)
			if fmt == target_fmt then
				local args = {...}
				if #args >= 4 then
					args[3] = japanese_patch.commas_to_number(args[3]) -- 報酬額
					return backup_format(fmt, args[2], args[3], args[1])
				end
			end
			return backup_format(fmt, ...)
		end

		local ok, res = pcall(original_get_phrase_1, ...)
		string.format = backup_format
		if not ok then error(res, 0) end
		return res
	end
end

-- ===================================================================
--  get_phrase2 （空白を削除、語尾を追加）
-- ===================================================================
if tasks_guide
and tasks_guide.get_phrase2
then
	local original_get_phrase2 = tasks_guide.get_phrase2

	tasks_guide.get_phrase2 = function(...)
		local txt = original_get_phrase2(...)
		if type(txt) == "string" then
			local prefix = game.translate_string("st_jg_17") -- "目的地は"
			txt = txt:gsub("^" .. prefix .. "%s+(.+)", prefix .. "%1だ。")
		end
		return txt
	end
end
